{
  "name": "bookstore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:generate && next build",
    "start": "next start",
    "typecheck": "pnpm db:generate && next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "test:source-failure": "tsx scripts/source-failure-smoke.ts",
    "db:generate": "prisma generate && prisma generate --config prisma.security.config.ts",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:status": "tsx scripts/database.ts status",
    "db:seed": "tsx prisma/seed.ts",
    "db:local:init": "node scripts/local-db.mjs init",
    "db:local:start": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "db:local:status": "node scripts/local-db.mjs status",
    "auth:spike:generate": "prisma generate --schema experiments/auth-spike/schema.prisma",
    "auth:spike:typecheck": "pnpm db:generate && pnpm auth:spike:generate && tsc --project experiments/auth-spike/tsconfig.json --noEmit",
    "auth:spike:test": "pnpm db:generate && pnpm auth:spike:generate && vitest run --config experiments/auth-spike/vitest.config.ts",
    "auth:spike:local:init": "node experiments/auth-spike/local-db.mjs init",
    "auth:spike:local:start": "node experiments/auth-spike/local-db.mjs start",
    "auth:spike:local:stop": "node experiments/auth-spike/local-db.mjs stop",
    "auth:spike:local:status": "node experiments/auth-spike/local-db.mjs status",
    "security:generate": "prisma generate --config prisma.security.config.ts",
    "security:test": "pnpm db:generate && vitest run --config vitest.security.config.ts",
    "security:migrate": "tsx scripts/security-database.ts deploy",
    "security:local:init": "node scripts/security-local-db.mjs init",
    "security:local:start": "node scripts/security-local-db.mjs start",
    "security:local:stop": "node scripts/security-local-db.mjs stop",
    "security:local:status": "node scripts/security-local-db.mjs status",
    "provider:proof:test": "pnpm db:generate && vitest run --config vitest.provider-proof.config.ts",
    "admission:controls:test": "pnpm db:generate && vitest run --config vitest.admission-controls.config.ts",
    "transport:https:test": "pnpm db:generate && vitest run --config vitest.https-transport.config.ts",
    "transport:browser:test": "pnpm db:generate && vitest run --config vitest.https-browser.config.ts",
    "transport:default-off:test": "tsx scripts/transport-default-off-smoke.ts",
    "next-security:build": "node --import tsx scripts/next-security-build.ts",
    "next-security:policy:test": "vitest run --config vitest.next-policy.config.ts",
    "next-security:test": "vitest run --config vitest.next-security.config.ts",
    "next-security:browser:test": "vitest run --config vitest.next-browser.config.ts",
    "next-security:reconciliation:test": "vitest run --config vitest.reconciliation.config.ts",
    "next-security:default-off:test": "node --import tsx scripts/next-security-default-off.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@better-auth/prisma-adapter": "1.7.18",
    "@better-auth/utils": "0.5.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-auth": "1.7.18",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
