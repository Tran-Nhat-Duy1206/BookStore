# Fixture mode is the default and requires no running database.
DATA_SOURCE=fixture

# For the isolated local instance only; never use another project's database.
# db:local:init creates ignored .env.local with random local-only credentials.
# Manual/Docker setup: replace LOCAL_ONLY_PASSWORD; bind only 127.0.0.1:55432.
# DATABASE_URL=postgresql://bookstore_catalog:LOCAL_ONLY_PASSWORD@127.0.0.1:55432/bookstore_catalog_dev
# TEST_DATABASE_URL=postgresql://bookstore_catalog:LOCAL_ONLY_PASSWORD@127.0.0.1:55432/bookstore_catalog_test
# BOOKSTORE_POSTGRES_PASSWORD=LOCAL_ONLY_PASSWORD

# Only needed to opt into database reads in a LOCAL production-build smoke test.
# This is not approval for production database activation or deployment.
# BOOKSTORE_LOCAL_DB_READS=1

# Optional native PostgreSQL bin directory (uses installed binaries, not services).
# PG_BIN=C:\Program Files\PostgreSQL\18\bin
